{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "middleware.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cortexma",
    "ec-spr-mnp-simulator",
    "nefroassist-ai",
    "uro-clinico-ai",
    "sgtr-goes-ambiental",
    "holyiot_belongings",
    "lattes-inep-app",
    "odonto-modular-ai",
    "residuos-massa-estimada",
    "escola-musica-cobrancas-mvp",
    "chamador_android_wrapper",
    "chamador_garcom_publish"
  ]
}
